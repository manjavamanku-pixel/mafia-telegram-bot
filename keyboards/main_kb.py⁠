from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.utils.keyboard import InlineKeyboardBuilder
from utils.lang import t

LANG_FLAGS = {
    "uz": "🇺🇿 O'zbek", "ru": "🇷🇺 Rus", "en": "🇬🇧 English",
    "kz": "🇰🇿 Qozoq", "tj": "🇹🇯 Tojik", "tm": "🇹🇲 Turkman",
    "az": "🇦🇿 Ozarbayjon", "tr": "🇹🇷 Turk", "de": "🇩🇪 Nemis", "ar": "🇸🇦 Arab"
}

def lang_keyboard(enabled_langs: list[str]) -> InlineKeyboardMarkup:
    builder = InlineKeyboardBuilder()
    for code, label in LANG_FLAGS.items():
        if code in enabled_langs:
            builder.button(text=label, callback_data=f"lang_{code}")
    builder.adjust(1)
    return builder.as_markup()

